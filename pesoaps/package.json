{
  "name": "pe-soaps-social-posts",
  "version": "1.0.0",
  "description": "PESoaps daily Facebook and Instagram publishing on Cloudflare",
  "scripts": {
    "dev": "sh ./scripts/wrangler.sh dev --test-scheduled",
    "types": "sh ./scripts/wrangler.sh types --strict-vars=false",
    "check": "npm run types && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "sh ./scripts/wrangler.sh deploy --dry-run",
    "deploy": "sh ./scripts/wrangler.sh deploy",
    "db:migrate": "sh ./scripts/wrangler.sh d1 migrations apply pe-soaps-social-posts --remote"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.139.0"
  },
  "private": true
}
